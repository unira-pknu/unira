# Runtime crawler data: files/ holds only collected files. The crawl state (what was
# already read) lives in state/ and is committed so the GitHub Actions crawls continue
# from the last run; its backups (*.bak, below) and lock files stay local.
files/
FILES/
state/**/*.lock
output/
outputs/
preprocessed/
vectorized/
var/
logs/
*.log
ask_results.json
eval/results/*
!eval/results/.gitkeep

# Crawler state, backups, and temporary artifacts
state.json
state_*.json
*.bak
*.tmp
.crawl_start.txt
backups/
inspect_site.py
nav_output.txt

# Python environments, bytecode, tests, and coverage
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local secrets and environment overrides
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local assistant configuration
CLAUDE.md
# Local OCR language models
.tools/tessdata/

# Local data files
pknu_main_collection_inventory.csv
MANUAL_100_QUESTIONS_REVIEW_2026-11-06.md
/files
